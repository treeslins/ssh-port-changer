#!/usr/bin/env bash
# SSH Port Changer V3.0
set -u
set -o pipefail
VERSION="3.0"
STATE_DIR="/var/lib/ssh-port-changer"
STATE_FILE="${STATE_DIR}/state"
BACKUP_ROOT="/root/ssh-port-changer-backups"
SSHD_CONFIG="/etc/ssh/sshd_config"
CONFIG_DIR="/etc/ssh/sshd_config.d"
CUSTOM_CONFIG="${CONFIG_DIR}/99-custom-ssh-port.conf"
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'
info(){ echo -e "${BLUE}[INFO]${NC} $*"; }; ok(){ echo -e "${GREEN}[ OK ]${NC} $*"; }; warn(){ echo -e "${YELLOW}[WARN]${NC} $*"; }; err(){ echo -e "${RED}[ERR ]${NC} $*" >&2; }; die(){ err "$*"; exit 1; }; line(){ echo "============================================================"; }
[[ "$EUID" -eq 0 ]] || die "请使用 root 用户运行。"
OS_NAME="Unknown Linux"; [[ -f /etc/os-release ]] && { source /etc/os-release; OS_NAME="${PRETTY_NAME:-${NAME:-Unknown Linux}}"; }
SSHD_BIN="$(command -v sshd 2>/dev/null || true)"; [[ -z "$SSHD_BIN" && -x /usr/sbin/sshd ]] && SSHD_BIN=/usr/sbin/sshd; [[ -n "$SSHD_BIN" ]] || die "未找到 sshd，请先安装 OpenSSH Server。"
detect_ssh(){ SSH_SERVICE="unknown"; SSH_SOCKET=0; command -v systemctl >/dev/null 2>&1 || return; systemctl list-unit-files 2>/dev/null | grep -q '^ssh\.service' && SSH_SERVICE=ssh || { systemctl list-unit-files 2>/dev/null | grep -q '^sshd\.service' && SSH_SERVICE=sshd; }; systemctl is-active --quiet ssh.socket 2>/dev/null && SSH_SOCKET=1; }
detect_ssh
get_port(){ local p; p="$("$SSHD_BIN" -T 2>/dev/null | awk '$1=="port"{print $2;exit}')"; echo "${p:-22}"; }
listening(){ local p="$1"; if command -v ss >/dev/null; then ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]${p}$"; else netstat -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]${p}$"; fi; }
detect_fw(){ FIREWALL=None; command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi '^Status: active' && { FIREWALL=UFW; return; }; command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1 && { FIREWALL=firewalld; return; }; command -v nft >/dev/null 2>&1 && systemctl is-active --quiet nftables 2>/dev/null && { FIREWALL=nftables; return; }; if command -v iptables >/dev/null 2>&1; then local p; p="$(iptables -S INPUT 2>/dev/null | awk '/^-P INPUT/{print $3;exit}')"; [[ "$p" == DROP || "$p" == REJECT ]] && FIREWALL=iptables; fi; }
detect_fw
allow_port(){ local p="$1"; FW_ADDED=0; case "$FIREWALL" in UFW) ufw status | grep -Eq "^${p}/tcp[[:space:]]+ALLOW" || { ufw allow "${p}/tcp" || die "UFW 放行失败"; FW_ADDED=1; };; firewalld) local z; z="$(firewall-cmd --get-default-zone)"; firewall-cmd --zone="$z" --query-port="${p}/tcp" >/dev/null 2>&1 || { firewall-cmd --zone="$z" --add-port="${p}/tcp" --permanent >/dev/null || die "firewalld 放行失败"; firewall-cmd --reload >/dev/null; FW_ADDED=1; };; nftables) nft list ruleset 2>/dev/null | grep -Eq "tcp dport[[:space:]]+${p}([[:space:]]|$).*accept" || die "检测到独立 nftables，请先手动放行 TCP ${p} 后重试。";; iptables) iptables -C INPUT -p tcp --dport "$p" -j ACCEPT >/dev/null 2>&1 || { iptables -I INPUT 1 -p tcp --dport "$p" -j ACCEPT || die "iptables 放行失败"; FW_ADDED=1; };; *) ok "未检测到需要处理的主机防火墙";; esac; }
restart_ssh(){ if [[ "$SSH_SERVICE" != unknown ]] && command -v systemctl >/dev/null; then systemctl restart "$SSH_SERVICE" || return 1; else service ssh restart 2>/dev/null || service sshd restart 2>/dev/null || return 1; fi; [[ "$SSH_SOCKET" -eq 1 ]] && systemctl restart ssh.socket || true; }
backup_config(){ BACKUP_DIR="${BACKUP_ROOT}/$(date +%Y%m%d-%H%M%S)"; mkdir -p "$BACKUP_DIR"; cp -a "$SSHD_CONFIG" "$BACKUP_DIR/sshd_config"; [[ -d "$CONFIG_DIR" ]] && cp -a "$CONFIG_DIR" "$BACKUP_DIR/sshd_config.d"; [[ -d /etc/systemd/system/ssh.socket.d ]] && cp -a /etc/systemd/system/ssh.socket.d "$BACKUP_DIR/ssh.socket.d"; }
rollback(){ warn "恢复 SSH 配置"; cp -a "$BACKUP_DIR/sshd_config" "$SSHD_CONFIG"; if [[ -d "$BACKUP_DIR/sshd_config.d" ]]; then rm -rf "$CONFIG_DIR"; cp -a "$BACKUP_DIR/sshd_config.d" "$CONFIG_DIR"; else rm -f "$CUSTOM_CONFIG"; fi; if [[ -d "$BACKUP_DIR/ssh.socket.d" ]]; then rm -rf /etc/systemd/system/ssh.socket.d; cp -a "$BACKUP_DIR/ssh.socket.d" /etc/systemd/system/ssh.socket.d; fi; systemctl daemon-reload 2>/dev/null || true; restart_ssh || true; warn "已回滚 SSH；新端口防火墙规则为安全起见暂不删除。"; }
modify(){ local p="$1"; if grep -Eq '^[[:space:]]*Include[[:space:]].*sshd_config\.d' "$SSHD_CONFIG"; then mkdir -p "$CONFIG_DIR"; sed -i -E 's/^([[:space:]]*)Port[[:space:]]+([0-9]+)/\1# Port \2/' "$SSHD_CONFIG"; while IFS= read -r -d '' f; do [[ "$f" == "$CUSTOM_CONFIG" ]] && continue; sed -i -E 's/^([[:space:]]*)Port[[:space:]]+([0-9]+)/\1# Port \2/' "$f"; done < <(find "$CONFIG_DIR" -maxdepth 1 -type f -name '*.conf' -print0 2>/dev/null); printf '# Generated by SSH Port Changer V%s\nPort %s\n' "$VERSION" "$p" > "$CUSTOM_CONFIG"; else sed -i -E 's/^([[:space:]]*)Port[[:space:]]+([0-9]+)/\1# Port \2/' "$SSHD_CONFIG"; printf '\n# SSH Port Changer V%s\nPort %s\n' "$VERSION" "$p" >> "$SSHD_CONFIG"; fi; if [[ "$SSH_SOCKET" -eq 1 ]]; then mkdir -p /etc/systemd/system/ssh.socket.d; printf '[Socket]\nListenStream=\nListenStream=%s\n' "$p" > /etc/systemd/system/ssh.socket.d/listen.conf; systemctl daemon-reload; fi; }
save_state(){ mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"; cat > "$STATE_FILE" <<EOF
OLD_PORT=$1
NEW_PORT=$2
FIREWALL=$3
FIREWALL_RULE_ADDED=$4
BACKUP_DIR=$5
CHANGE_TIME=$(date --iso-8601=seconds 2>/dev/null || date)
EOF
chmod 600 "$STATE_FILE"; }
load_state(){ [[ -f "$STATE_FILE" ]] || die "没有找到历史修改记录"; source "$STATE_FILE"; }
status(){ local p; p="$(get_port)"; echo; line; echo -e "${CYAN}SSH Port Changer V${VERSION}${NC}"; line; echo "系统：$OS_NAME"; echo "SSH 服务：$SSH_SERVICE"; echo "配置端口：$p"; echo "防火墙：$FIREWALL"; if listening "$p"; then ok "TCP $p 正在监听"; else err "TCP $p 未监听"; fi; [[ -f "$STATE_FILE" ]] && { load_state; echo "上次修改：$OLD_PORT -> $NEW_PORT"; echo "时间：$CHANGE_TIME"; }; echo; }
cleanup(){ load_state; listening "$NEW_PORT" || die "新端口 ${NEW_PORT} 未监听，拒绝清理旧端口"; [[ "$(get_port)" == "$NEW_PORT" ]] || die "当前 SSH 配置与记录不一致，拒绝清理"; echo "将清理旧 SSH 防火墙端口：${OLD_PORT}/tcp"; read -r -p '确认？[y/N]: ' a; [[ "$a" =~ ^[Yy]$ ]] || exit 0; detect_fw; case "$FIREWALL" in UFW) ufw --force delete allow "${OLD_PORT}/tcp" || true;; firewalld) z="$(firewall-cmd --get-default-zone)"; firewall-cmd --zone="$z" --remove-port="${OLD_PORT}/tcp" --permanent || true; firewall-cmd --reload || true;; iptables) iptables -C INPUT -p tcp --dport "$OLD_PORT" -j ACCEPT >/dev/null 2>&1 && iptables -D INPUT -p tcp --dport "$OLD_PORT" -j ACCEPT;; nftables) warn "独立 nftables 不自动删除规则，请手动检查。";; *) info "无需清理主机防火墙";; esac; ok "清理完成"; }
change(){ local new="$1" yes="$2" old; [[ "$new" =~ ^[0-9]+$ ]] || die "端口必须是数字"; ((new>=1 && new<=65535)) || die "端口范围必须为 1-65535"; old="$(get_port)"; [[ "$old" == "$new" ]] && { warn "当前已经是端口 $new"; exit 0; }; listening "$new" && die "目标端口 $new 已被占用"; echo; line; echo "系统：$OS_NAME"; echo "当前端口：$old"; echo "目标端口：$new"; echo "防火墙：$FIREWALL"; line; if [[ "$yes" -eq 0 ]]; then read -r -p '是否继续？[Y/n]: ' a; [[ "${a:-Y}" =~ ^[Yy]$ ]] || exit 0; fi; backup_config; ok "已备份到 $BACKUP_DIR"; allow_port "$new"; modify "$new"; "$SSHD_BIN" -t || { err "sshd 配置检查失败"; rollback; exit 1; }; [[ "$(get_port)" == "$new" ]] || { err "sshd 实际端口与目标不一致"; rollback; exit 1; }; restart_ssh || { err "SSH 重启失败"; rollback; exit 1; }; sleep 2; listening "$new" || { err "新端口未监听"; rollback; exit 1; }; save_state "$old" "$new" "$FIREWALL" "$FW_ADDED" "$BACKUP_DIR"; echo; ok "SSH 已修改为端口 $new"; warn "不要关闭当前 SSH 窗口。请新开终端测试：ssh -p $new root@服务器IP"; warn "云服务器还需在云平台安全组放行 TCP $new"; echo "确认新端口可登录后运行：$0 --cleanup"; }
ACTION="${1:-}"; case "$ACTION" in --status|-s) status; exit;; --cleanup|-c) cleanup; exit;; --help|-h) echo "用法：$0 PORT [-y] | --status | --cleanup"; exit;; '') read -r -p '请输入新的 SSH 端口: ' ACTION;; esac
YES=0; for a in "$@"; do [[ "$a" == -y || "$a" == --yes ]] && YES=1; done
change "$ACTION" "$YES"
