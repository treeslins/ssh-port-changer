#!/usr/bin/env bash
# SSH Port Changer V5.0
# https://github.com/treeslins/ssh-port-changer

set -u
set -o pipefail

SCRIPT_VERSION="5.0"
STATE_DIR="/var/lib/ssh-port-changer"
STATE_FILE="$STATE_DIR/state"
BACKUP_ROOT="/root/ssh-port-changer-backups"
SSHD_CONFIG="/etc/ssh/sshd_config"
MANAGED_BEGIN="# BEGIN SSH PORT CHANGER"
MANAGED_END="# END SSH PORT CHANGER"
SOCKET_OVERRIDE="/etc/systemd/system/ssh.socket.d/90-ssh-port-changer.conf"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'
info(){ echo -e "${BLUE}[INFO]${NC} $*"; }
ok(){ echo -e "${GREEN}[ OK ]${NC} $*"; }
warn(){ echo -e "${YELLOW}[WARN]${NC} $*"; }
err(){ echo -e "${RED}[ERR ]${NC} $*" >&2; }
die(){ err "$*"; exit 1; }
line(){ printf '%s\n' '============================================================'; }
step_line(){ printf '%s\n' '------------------------------------------------------------'; }
pause(){ local _; read -r -p '按 Enter 返回...' _; }

[[ $EUID -eq 0 ]] || die "请使用 root 用户运行。"
[[ -f "$SSHD_CONFIG" ]] || die "找不到 $SSHD_CONFIG"

OS_NAME="Unknown Linux"
if [[ -f /etc/os-release ]]; then
  # shellcheck disable=SC1091
  source /etc/os-release
  OS_NAME="${PRETTY_NAME:-${NAME:-Unknown Linux}}"
fi

SSHD_BIN="$(command -v sshd 2>/dev/null || true)"
[[ -z "$SSHD_BIN" && -x /usr/sbin/sshd ]] && SSHD_BIN=/usr/sbin/sshd
[[ -n "$SSHD_BIN" ]] || die "未找到 sshd，请先安装 OpenSSH Server。"

SSH_SERVICE="unknown"; SSH_SOCKET=0
systemd_unit_loaded(){ [[ "$(systemctl show -p LoadState --value "$1" 2>/dev/null || true)" == "loaded" ]]; }
detect_ssh_service(){
  SSH_SERVICE="unknown"; SSH_SOCKET=0
  command -v systemctl >/dev/null 2>&1 || return 0
  if systemd_unit_loaded ssh.service; then SSH_SERVICE=ssh
  elif systemd_unit_loaded sshd.service; then SSH_SERVICE=sshd; fi
  if systemctl is-active --quiet ssh.socket 2>/dev/null; then SSH_SOCKET=1; fi
}
detect_ssh_service

get_effective_port(){ local p; p="$("$SSHD_BIN" -T 2>/dev/null | awk '$1=="port"{print $2;exit}')"; printf '%s\n' "${p:-22}"; }
port_listener(){
  local p="$1"
  if command -v ss >/dev/null 2>&1; then ss -lntp 2>/dev/null | grep -E "[:.]${p}[[:space:]]" || true
  elif command -v netstat >/dev/null 2>&1; then netstat -lntp 2>/dev/null | grep -E "[:.]${p}[[:space:]]" || true; fi
}
port_is_listening(){ [[ -n "$(port_listener "$1")" ]]; }
ssh_port_is_listening(){
  local p="$1" out; out="$(port_listener "$p")"; [[ -n "$out" ]] || return 1
  if [[ "$SSH_SOCKET" -eq 1 ]]; then grep -Eq '(sshd|systemd)' <<< "$out"; else grep -q 'sshd' <<< "$out"; fi
}

check_listenaddress(){
  local found=""
  found="$(grep -RhsEi '^[[:space:]]*ListenAddress[[:space:]]+(\[[^]]+\]:[0-9]+|[^[:space:]:]+:[0-9]+)' "$SSHD_CONFIG" /etc/ssh/sshd_config.d 2>/dev/null || true)"
  if [[ -n "$found" ]]; then warn "检测到 ListenAddress 显式指定端口："; printf '%s\n' "$found"; die "为避免改变自定义监听拓扑，当前版本不会自动修改这种配置。"; fi
}

FIREWALL="None"; FW_ZONES=""
detect_firewall(){
  FIREWALL="None"; FW_ZONES=""
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi '^Status: active'; then FIREWALL=UFW; return; fi
  if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
    FIREWALL=firewalld; FW_ZONES="$(firewall-cmd --get-active-zones 2>/dev/null | awk 'NF && $1 !~ /^[[:space:]]/{print $1}' | paste -sd, -)"
    [[ -z "$FW_ZONES" ]] && FW_ZONES="$(firewall-cmd --get-default-zone 2>/dev/null)"; return
  fi
  if command -v nft >/dev/null 2>&1 && nft list ruleset 2>/dev/null | grep -q 'hook input'; then FIREWALL=nftables; return; fi
  if command -v iptables >/dev/null 2>&1 && iptables -S INPUT 2>/dev/null | grep -Eq '(^-P INPUT (DROP|REJECT)| -j (DROP|REJECT)( |$))'; then FIREWALL=iptables; fi
}
detect_firewall

persist_iptables(){
  if command -v netfilter-persistent >/dev/null 2>&1; then netfilter-persistent save >/dev/null 2>&1 && return 0; fi
  if [[ -d /etc/iptables ]] && command -v iptables-save >/dev/null 2>&1; then iptables-save > /etc/iptables/rules.v4 && return 0; fi
  warn "iptables 规则已生效，但未检测到可靠的持久化机制。"
}
FW_NEW_ADDED=0
allow_new_port(){
  local p="$1" z; FW_NEW_ADDED=0
  case "$FIREWALL" in
    UFW) if ! ufw status 2>/dev/null | grep -Eq "^${p}/tcp[[:space:]]+ALLOW"; then ufw allow "${p}/tcp" || die "UFW 放行失败"; FW_NEW_ADDED=1; fi ;;
    firewalld)
      IFS=',' read -ra zones <<< "$FW_ZONES"
      for z in "${zones[@]}"; do [[ -z "$z" ]] && continue; if ! firewall-cmd --zone="$z" --query-port="${p}/tcp" >/dev/null 2>&1; then firewall-cmd --zone="$z" --add-port="${p}/tcp" --permanent >/dev/null || die "firewalld 放行失败：$z"; FW_NEW_ADDED=1; fi; done
      firewall-cmd --reload >/dev/null || die "firewalld reload 失败" ;;
    nftables) nft list ruleset 2>/dev/null | grep -Eq "tcp dport[[:space:]]+${p}([[:space:]]|$).*accept" || die "检测到自定义 nftables。请先手动放行 TCP ${p} 后重试。" ;;
    iptables) if ! iptables -C INPUT -p tcp --dport "$p" -j ACCEPT >/dev/null 2>&1; then iptables -I INPUT 1 -p tcp --dport "$p" -j ACCEPT || die "iptables 放行失败"; FW_NEW_ADDED=1; persist_iptables; fi ;;
    *) warn "未检测到活动的受支持主机防火墙；请同时确认云安全组/上游防火墙。" ;;
  esac
}

SELINUX_ADDED=0
configure_selinux(){
  local p="$1" mode; SELINUX_ADDED=0; command -v getenforce >/dev/null 2>&1 || return 0
  mode="$(getenforce 2>/dev/null || true)"; [[ "$mode" == Enforcing || "$mode" == Permissive ]] || return 0
  command -v semanage >/dev/null 2>&1 || die "SELinux 已启用但缺少 semanage。请先安装 policycoreutils-python-utils。"
  if semanage port -l 2>/dev/null | awk '$1=="ssh_port_t"{for(i=3;i<=NF;i++)print $i}' | tr ',' '\n' | grep -qx "$p"; then return 0; fi
  if semanage port -a -t ssh_port_t -p tcp "$p" 2>/dev/null; then SELINUX_ADDED=1
  elif semanage port -m -t ssh_port_t -p tcp "$p" 2>/dev/null; then SELINUX_ADDED=1
  else die "SELinux ssh_port_t 配置失败"; fi
}

backup_config(){
  BACKUP_DIR="${BACKUP_ROOT}/$(date +%Y%m%d-%H%M%S)"; mkdir -p "$BACKUP_DIR"; cp -a "$SSHD_CONFIG" "$BACKUP_DIR/sshd_config"
  if [[ -f "$SOCKET_OVERRIDE" ]]; then cp -a "$SOCKET_OVERRIDE" "$BACKUP_DIR/ssh-port-changer.socket.conf"; : > "$BACKUP_DIR/socket-override-existed"; fi
}
restore_backup(){
  local b="$1"; [[ -f "$b/sshd_config" ]] || die "无效备份：$b"; cp -a "$b/sshd_config" "$SSHD_CONFIG"
  if [[ -f "$b/socket-override-existed" ]]; then mkdir -p "$(dirname "$SOCKET_OVERRIDE")"; cp -a "$b/ssh-port-changer.socket.conf" "$SOCKET_OVERRIDE"; else rm -f "$SOCKET_OVERRIDE"; fi
  if command -v systemctl >/dev/null 2>&1; then systemctl daemon-reload >/dev/null 2>&1 || true; fi
  "$SSHD_BIN" -t || die "恢复后的 SSH 配置校验失败，请保持当前会话并手动检查。"; restart_ssh || die "配置已恢复，但 SSH 服务重启失败。"
}
restart_ssh(){
  if [[ "$SSH_SOCKET" -eq 1 ]] && command -v systemctl >/dev/null 2>&1; then systemctl restart ssh.socket || return 1; if [[ "$SSH_SERVICE" != unknown ]]; then systemctl try-restart "$SSH_SERVICE" >/dev/null 2>&1 || true; fi
  elif [[ "$SSH_SERVICE" != unknown ]] && command -v systemctl >/dev/null 2>&1; then systemctl restart "$SSH_SERVICE" || return 1
  elif command -v service >/dev/null 2>&1; then service ssh restart 2>/dev/null || service sshd restart 2>/dev/null || return 1
  else return 1; fi
}
set_global_port(){
  local p="$1" tmp; tmp="$(mktemp)"
  awk -v port="$p" -v begin="$MANAGED_BEGIN" -v end="$MANAGED_END" '
    BEGIN{inmanaged=0; done=0; matchseen=0}
    $0==begin {inmanaged=1; next} $0==end {inmanaged=0; next} inmanaged {next}
    /^[[:space:]]*Match[[:space:]]/ && !matchseen {if(!done){print begin; print "Port " port; print end; done=1} matchseen=1}
    !matchseen && /^[[:space:]]*Port[[:space:]]+[0-9]+([[:space:]]*(#.*)?)?$/ {print "# " $0 " # disabled by SSH Port Changer"; next}
    {print} END{if(!done){print ""; print begin; print "Port " port; print end}}
  ' "$SSHD_CONFIG" > "$tmp" || { rm -f "$tmp"; die "生成 SSH 配置失败"; }
  cat "$tmp" > "$SSHD_CONFIG"; rm -f "$tmp"
  if [[ "$SSH_SOCKET" -eq 1 ]]; then mkdir -p "$(dirname "$SOCKET_OVERRIDE")"; printf '[Socket]\nListenStream=\nListenStream=%s\n' "$p" > "$SOCKET_OVERRIDE"; systemctl daemon-reload || die "systemd daemon-reload 失败"; fi
}

save_state(){ mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"; printf 'OLD_PORT=%s\nNEW_PORT=%s\nFIREWALL=%s\nFW_ZONES=%s\nFW_NEW_ADDED=%s\nSELINUX_ADDED=%s\nBACKUP_DIR=%s\nCHANGE_TIME=%s\n' "$1" "$2" "$FIREWALL" "$FW_ZONES" "$FW_NEW_ADDED" "$SELINUX_ADDED" "$BACKUP_DIR" "$(date --iso-8601=seconds 2>/dev/null || date)" > "$STATE_FILE"; chmod 600 "$STATE_FILE"; }
load_state(){
  [[ -f "$STATE_FILE" ]] || die "没有找到历史修改记录"; OLD_PORT=""; NEW_PORT=""; SAVED_FIREWALL=""; SAVED_ZONES=""; SAVED_FW_ADDED=0; SAVED_SELINUX_ADDED=0; BACKUP_DIR=""; CHANGE_TIME=""
  while IFS='=' read -r k v; do case "$k" in OLD_PORT) OLD_PORT="$v";; NEW_PORT) NEW_PORT="$v";; FIREWALL) SAVED_FIREWALL="$v";; FW_ZONES) SAVED_ZONES="$v";; FW_NEW_ADDED) SAVED_FW_ADDED="$v";; SELINUX_ADDED) SAVED_SELINUX_ADDED="$v";; BACKUP_DIR) BACKUP_DIR="$v";; CHANGE_TIME) CHANGE_TIME="$v";; esac; done < "$STATE_FILE"
  [[ "$OLD_PORT" =~ ^[0-9]+$ && "$NEW_PORT" =~ ^[0-9]+$ && "$BACKUP_DIR" == "$BACKUP_ROOT/"* ]] || die "状态文件异常，拒绝继续。"
}

status(){
  local p; p="$(get_effective_port)"; echo; line; echo -e "${CYAN}SSH Port Changer V${SCRIPT_VERSION}${NC}"; line
  echo "系统：$OS_NAME"; echo "SSH 服务：$SSH_SERVICE"; echo "SSH Socket：$([[ $SSH_SOCKET -eq 1 ]] && echo Enabled || echo Disabled)"; echo "配置端口：$p"; echo "防火墙：$FIREWALL"
  if ssh_port_is_listening "$p"; then ok "已确认 SSH 在 TCP $p 监听"; else warn "未能确认 sshd/systemd 在 TCP $p 监听"; fi
  if [[ -n "${SSH_CONNECTION:-}" ]]; then echo "当前 SSH 会话端口：$(awk '{print $4}' <<< "$SSH_CONNECTION")"; fi
  if [[ -f "$STATE_FILE" ]]; then load_state; echo "上次修改：$OLD_PORT -> $NEW_PORT"; echo "修改时间：$CHANGE_TIME"; echo "备份：$BACKUP_DIR"; echo "修改时防火墙：$SAVED_FIREWALL"; [[ -n "$SAVED_ZONES" ]] && echo "firewalld 区域：$SAVED_ZONES"; echo "新增防火墙规则：$SAVED_FW_ADDED"; echo "新增 SELinux 端口映射：$SAVED_SELINUX_ADDED"; fi; echo
}
cleanup(){
  load_state; ssh_port_is_listening "$NEW_PORT" || die "未确认新 SSH 端口 ${NEW_PORT} 正常监听，拒绝清理。"; [[ "$(get_effective_port)" == "$NEW_PORT" ]] || die "当前有效 SSH 端口与状态记录不一致。"
  local cp=""; if [[ -n "${SSH_CONNECTION:-}" ]]; then cp="$(awk '{print $4}' <<< "$SSH_CONNECTION")"; fi
  if [[ "$cp" == "$OLD_PORT" ]]; then warn "当前会话仍通过旧端口登录，请先测试新端口。"; fi
  warn "脚本无法证明旧端口防火墙规则由本工具创建，因此不会自动删除旧端口规则。"; echo "请确认新端口稳定后，根据实际防火墙策略手动移除不再需要的 TCP ${OLD_PORT} 放行规则。"
}
rollback(){
  load_state; echo "将恢复：$BACKUP_DIR（$OLD_PORT -> $NEW_PORT）"; read -r -p '确认回滚 SSH 配置？[y/N]: ' a; [[ "$a" =~ ^[Yy]$ ]] || return 0
  restore_backup "$BACKUP_DIR"; ok "SSH 配置已恢复。"; warn "为避免失联，防火墙和 SELinux 新端口规则不会自动删除。"
}

change_port(){
  local new="$1" yes="$2" old
  [[ "$new" =~ ^[0-9]+$ ]] || die "端口必须是数字"; ((new>=1 && new<=65535)) || die "端口范围必须为 1-65535"; "$SSHD_BIN" -t || die "当前 sshd 配置本身存在错误，请先修复。"; check_listenaddress
  old="$(get_effective_port)"; [[ "$old" == "$new" ]] && { warn "SSH 当前有效端口已经是 $new"; return 0; }; if port_is_listening "$new"; then err "目标端口 $new 已被占用："; port_listener "$new"; return 1; fi
  echo; line; echo "SSH Port Changer V$SCRIPT_VERSION"; echo "系统：$OS_NAME"; echo "当前端口：$old"; echo "目标端口：$new"; echo "防火墙：$FIREWALL"; line
  if [[ "$yes" -eq 0 ]]; then read -r -p '是否继续？[Y/n]: ' a; [[ "${a:-Y}" =~ ^[Yy]$ ]] || return 0; fi
  backup_config; ok "配置已备份：$BACKUP_DIR"; allow_new_port "$new"; configure_selinux "$new"; set_global_port "$new"
  if ! "$SSHD_BIN" -t; then err "新配置 sshd -t 校验失败，自动恢复。"; restore_backup "$BACKUP_DIR"; return 1; fi
  if [[ "$(get_effective_port)" != "$new" ]]; then err "sshd -T 有效端口不是 $new，自动恢复。"; restore_backup "$BACKUP_DIR"; return 1; fi
  if ! restart_ssh; then err "SSH 重启失败，自动恢复。"; restore_backup "$BACKUP_DIR"; return 1; fi
  sleep 2; if ! ssh_port_is_listening "$new"; then err "未确认 SSH 在新端口监听，自动恢复。"; restore_backup "$BACKUP_DIR"; return 1; fi
  save_state "$old" "$new"; echo; ok "SSH 端口已修改：$old -> $new"; warn "不要关闭当前 SSH 会话。请新开终端测试：ssh -p $new root@服务器IP"; warn "云服务器还必须确认安全组/云防火墙已放行 TCP $new。"
}

random_port(){
  local p i
  for ((i=0;i<50;i++)); do
    if command -v shuf >/dev/null 2>&1; then p="$(shuf -i 20000-60000 -n 1)"; else p=$((20000 + RANDOM * 40001 / 32768)); fi
    if [[ "$p" != "$(get_effective_port)" ]] && ! port_is_listening "$p"; then printf '%s\n' "$p"; return 0; fi
  done
  return 1
}
select_port(){
  local choice p
  while true; do
    step_line; echo -e "${BOLD}步骤 1/5：选择新的 SSH 端口${NC}"; step_line; echo "当前 SSH 端口：$(get_effective_port)"; echo; echo "  1) 自动生成安全端口     [推荐]"; echo "  2) 手动输入端口"; echo "  3) 返回主菜单"; echo
    read -r -p '请选择 [默认 1]: ' choice; choice="${choice:-1}"
    case "$choice" in
      1)
        p="$(random_port)" || { warn "暂时无法生成可用端口。"; continue; }
        while true; do echo; echo "推荐的新端口：$p"; ok "当前没有程序占用 TCP $p"; echo; echo "  1) 使用 $p             [推荐]"; echo "  2) 换一个随机端口"; echo "  3) 手动输入"; echo "  4) 返回"; read -r -p '请选择 [默认 1]: ' choice; choice="${choice:-1}"; case "$choice" in 1) SELECTED_PORT="$p"; return 0;; 2) p="$(random_port)" || continue;; 3) read -r -p '请输入新端口: ' p; if [[ "$p" =~ ^[0-9]+$ ]] && ((p>=1 && p<=65535)) && ! port_is_listening "$p"; then SELECTED_PORT="$p"; return 0; else warn "端口无效或已被占用。"; fi;; 4) break;; *) warn "无效选择。";; esac; done ;;
      2) read -r -p '请输入新端口: ' p; if [[ "$p" =~ ^[0-9]+$ ]] && ((p>=1 && p<=65535)) && ! port_is_listening "$p"; then SELECTED_PORT="$p"; return 0; else warn "端口无效或已被占用。"; fi ;;
      3) return 1;; *) warn "无效选择。";;
    esac
  done
}
cloud_confirmation(){
  local choice
  while true; do
    step_line; echo -e "${BOLD}步骤 2/5：防火墙与云安全组检查${NC}"; step_line; echo "主机防火墙：$FIREWALL"; echo "目标端口：$SELECTED_PORT"; echo
    if [[ "$FIREWALL" == None ]]; then info "未检测到活动的受支持主机防火墙。"; else ok "检测到 $FIREWALL，修改时将尝试安全放行新端口。"; fi
    warn "本工具无法自动确认云厂商安全组或上游防火墙。"; echo "如果这是云服务器，请先在控制台确认 TCP $SELECTED_PORT 已允许入站。"; echo; echo "  1) 我已确认 TCP $SELECTED_PORT 已放行"; echo "  2) 我还没有确认            [推荐]"; echo "  3) 重新检测主机防火墙"; echo "  4) 返回主菜单"; echo
    read -r -p '请选择 [默认 2]: ' choice; choice="${choice:-2}"
    case "$choice" in 1) return 0;; 2) warn "请先确认安全组/上游防火墙，再继续修改。"; return 1;; 3) detect_firewall;; 4) return 1;; *) warn "无效选择。";; esac
  done
}
preflight(){
  step_line; echo -e "${BOLD}步骤 3/5：修改前安全检查${NC}"; step_line
  "$SSHD_BIN" -t || { err "当前 SSH 配置校验失败。"; return 1; }; ok "sshd -t 配置检查通过"
  check_listenaddress; if port_is_listening "$SELECTED_PORT"; then err "目标端口 $SELECTED_PORT 已被占用。"; return 1; fi
  ok "目标端口 $SELECTED_PORT 可用"; if ssh_port_is_listening "$(get_effective_port)"; then ok "当前 SSH 监听正常"; else warn "无法确认当前 SSH 监听状态。"; fi; return 0
}
final_confirmation(){
  local choice selinux="Disabled/Unknown"
  if command -v getenforce >/dev/null 2>&1; then selinux="$(getenforce 2>/dev/null || echo Unknown)"; fi
  step_line; echo -e "${BOLD}步骤 4/5：最终确认${NC}"; step_line
  printf '%-18s %s\n' "系统" "$OS_NAME" "SSH 服务" "$SSH_SERVICE" "SSH Socket" "$([[ $SSH_SOCKET -eq 1 ]] && echo Enabled || echo Disabled)" "当前端口" "$(get_effective_port)" "新端口" "$SELECTED_PORT" "主机防火墙" "$FIREWALL" "SELinux" "$selinux" "配置备份" "自动创建" "失败自动恢复" "Enabled"
  echo; echo "执行顺序：备份 -> 防火墙 -> SELinux -> 修改配置 -> sshd 校验 -> 重启 -> 监听验证"; echo; echo "  1) 开始修改                [推荐]"; echo "  2) 返回主菜单"; echo "  3) 退出"; echo
  read -r -p '请选择 [默认 1]: ' choice; choice="${choice:-1}"; [[ "$choice" == 1 ]]
}
post_change_guide(){
  local choice
  while true; do
    step_line; echo -e "${BOLD}步骤 5/5：新端口登录验证${NC}"; step_line; ok "服务端已确认 SSH 在 TCP $SELECTED_PORT 监听"; echo; warn "不要关闭当前 SSH 窗口。"; echo "请新开一个终端测试："; echo; echo "    ssh -p $SELECTED_PORT root@服务器IP"; echo; echo "新终端测试后回来选择："; echo "  1) 新端口登录成功          [推荐]"; echo "  2) 新端口无法连接"; echo "  3) 暂时不处理"; echo
    read -r -p '请选择: ' choice
    case "$choice" in 1) ok "新端口验证完成。"; status; return 0;; 2) echo; echo "  1) 立即恢复原 SSH 配置     [推荐]"; echo "  2) 查看当前状态"; echo "  3) 暂不恢复"; read -r -p '请选择 [默认 1]: ' choice; choice="${choice:-1}"; case "$choice" in 1) rollback; return 0;; 2) status;; 3) return 0;; esac;; 3) warn "请保留当前会话，直到确认新端口能够正常登录。"; return 0;; *) warn "无效选择。";; esac
  done
}
wizard_change(){ SELECTED_PORT=""; select_port || return 0; cloud_confirmation || return 0; preflight || { pause; return 0; }; final_confirmation || return 0; if change_port "$SELECTED_PORT" 1; then post_change_guide; else pause; fi; }
show_environment(){
  local p; p="$(get_effective_port)"; echo; line; echo -e "${CYAN}${BOLD} SSH Port Changer V$SCRIPT_VERSION${NC}"; echo " SSH 安全端口配置向导"; line; echo; echo "正在检测服务器环境..."; echo
  ok "系统：$OS_NAME"; [[ "$SSH_SERVICE" != unknown ]] && ok "SSH 服务：${SSH_SERVICE}.service" || warn "SSH 服务：未识别"; if [[ "$SSH_SOCKET" -eq 1 ]]; then info "SSH Socket：已启用"; else ok "SSH Socket：未启用"; fi; ok "当前 SSH 端口：$p"; if ssh_port_is_listening "$p"; then ok "SSH 正在正常监听"; else warn "未确认 SSH 监听"; fi; if [[ -n "${SSH_CONNECTION:-}" ]]; then ok "当前会话通过 TCP $(awk '{print $4}' <<< "$SSH_CONNECTION") 登录"; fi; if [[ "$FIREWALL" == None ]]; then info "主机防火墙：未检测到活动规则"; else info "主机防火墙：$FIREWALL"; fi; warn "云安全组：无法由本机自动确认"; echo
}
main_menu(){
  local choice
  while true; do
    show_environment; echo "请选择要执行的操作："; echo; echo "  1) 修改 SSH 端口        [推荐]"; echo "  2) 查看 SSH 状态"; echo "  3) 恢复上一次配置"; echo "  4) 查看旧端口清理建议"; echo "  5) 退出"; echo; read -r -p '请选择 [默认 1]: ' choice; choice="${choice:-1}"
    case "$choice" in 1) wizard_change;; 2) status; pause;; 3) if [[ -f "$STATE_FILE" ]]; then rollback; else warn "没有找到历史修改记录。"; fi; pause;; 4) if [[ -f "$STATE_FILE" ]]; then cleanup; else warn "没有找到历史修改记录。"; fi; pause;; 5) echo "已退出。"; return 0;; *) warn "无效选择。"; sleep 1;; esac
  done
}

ACTION="${1:-}"
case "$ACTION" in
  --status|-s) status; exit 0;;
  --cleanup|-c) cleanup; exit 0;;
  --rollback|-r) rollback; exit 0;;
  --version|-v) echo "SSH Port Changer V$SCRIPT_VERSION"; exit 0;;
  --help|-h) echo "用法：$0 [PORT [-y]] | --status | --cleanup | --rollback | --version"; echo "不带参数运行将进入交互式安全向导。"; exit 0;;
  '') main_menu; exit 0;;
esac
YES=0
for a in "$@"; do if [[ "$a" == -y || "$a" == --yes ]]; then YES=1; fi; done
change_port "$ACTION" "$YES"
