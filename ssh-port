#!/usr/bin/env bash
# SSH Port Changer V3.1
# https://github.com/treeslins/ssh-port-changer
set -u
set -o pipefail
VERSION="3.1"
STATE_DIR="/var/lib/ssh-port-changer"; STATE_FILE="$STATE_DIR/state"; BACKUP_ROOT="/root/ssh-port-changer-backups"
SSHD_CONFIG="/etc/ssh/sshd_config"; CONFIG_DIR="/etc/ssh/sshd_config.d"; CUSTOM_CONFIG="$CONFIG_DIR/99-custom-ssh-port.conf"
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'
info(){ echo -e "${BLUE}[INFO]${NC} $*"; }; ok(){ echo -e "${GREEN}[ OK ]${NC} $*"; }; warn(){ echo -e "${YELLOW}[WARN]${NC} $*"; }; err(){ echo -e "${RED}[ERR ]${NC} $*" >&2; }; die(){ err "$*"; exit 1; }; line(){ printf '%s\n' '============================================================'; }
[[ $EUID -eq 0 ]] || die "请使用 root 用户运行。"
OS_NAME="Unknown Linux"; OS_ID="unknown"; if [[ -f /etc/os-release ]]; then source /etc/os-release; OS_NAME="${PRETTY_NAME:-${NAME:-Unknown Linux}}"; OS_ID="${ID:-unknown}"; fi
SSHD_BIN="$(command -v sshd 2>/dev/null || true)"; [[ -z "$SSHD_BIN" && -x /usr/sbin/sshd ]] && SSHD_BIN=/usr/sbin/sshd; [[ -n "$SSHD_BIN" ]] || die "未找到 sshd，请先安装 OpenSSH Server。"
detect_ssh(){ SSH_SERVICE=unknown; SSH_SOCKET=0; command -v systemctl >/dev/null 2>&1 || return; systemctl list-unit-files 2>/dev/null | grep -q '^ssh\.service' && SSH_SERVICE=ssh || { systemctl list-unit-files 2>/dev/null | grep -q '^sshd\.service' && SSH_SERVICE=sshd; }; systemctl is-active --quiet ssh.socket 2>/dev/null && SSH_SOCKET=1 || true; }
detect_ssh
get_port(){ local p; p="$("$SSHD_BIN" -T 2>/dev/null | awk '$1=="port"{print $2;exit}')"; printf '%s\n' "${p:-22}"; }
listening(){ local p="$1"; if command -v ss >/dev/null 2>&1; then ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]${p}$"; elif command -v netstat >/dev/null 2>&1; then netstat -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]${p}$"; else return 1; fi; }
detect_fw(){ FIREWALL=None; command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi '^Status: active' && { FIREWALL=UFW; return; }; command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1 && { FIREWALL=firewalld; return; }; command -v nft >/dev/null 2>&1 && { nft list ruleset 2>/dev/null | grep -q 'hook input' && { FIREWALL=nftables; return; }; }; if command -v iptables >/dev/null 2>&1; then local p; p="$(iptables -S INPUT 2>/dev/null | awk '/^-P INPUT/{print $3;exit}')"; [[ "$p" == DROP || "$p" == REJECT ]] && FIREWALL=iptables; fi; }
detect_fw
persist_iptables(){ if command -v netfilter-persistent >/dev/null 2>&1; then netfilter-persistent save >/dev/null 2>&1 && { ok "iptables 规则已通过 netfilter-persistent 持久化"; return; }; fi; if [[ -d /etc/iptables ]] && command -v iptables-save >/dev/null 2>&1; then iptables-save > /etc/iptables/rules.v4 2>/dev/null && { ok "iptables 规则已保存到 /etc/iptables/rules.v4"; return; }; fi; warn "iptables 规则当前已生效，但未检测到可靠的持久化机制。重启后请确认规则仍存在。"; }
allow_port(){ local p="$1"; FW_ADDED=0; case "$FIREWALL" in UFW) ufw status | grep -Eq "^${p}/tcp[[:space:]]+ALLOW" || { ufw allow "${p}/tcp" || die "UFW 放行失败"; FW_ADDED=1; };; firewalld) local zones z; zones="$(firewall-cmd --get-active-zones 2>/dev/null | awk 'NF && $1 !~ /^[[:space:]]/{print $1}')"; [[ -z "$zones" ]] && zones="$(firewall-cmd --get-default-zone)"; while read -r z; do [[ -z "$z" ]] && continue; firewall-cmd --zone="$z" --query-port="${p}/tcp" >/dev/null 2>&1 || { firewall-cmd --zone="$z" --add-port="${p}/tcp" --permanent >/dev/null || die "firewalld 放行失败"; FW_ADDED=1; }; done <<< "$zones"; firewall-cmd --reload >/dev/null || die "firewalld reload 失败";; nftables) nft list ruleset 2>/dev/null | grep -Eq "tcp dport[[:space:]]+${p}([[:space:]]|$).*accept" || die "检测到自定义 nftables。为避免破坏现有规则，请先手动放行 TCP ${p} 后重试。";; iptables) iptables -C INPUT -p tcp --dport "$p" -j ACCEPT >/dev/null 2>&1 || { iptables -I INPUT 1 -p tcp --dport "$p" -j ACCEPT || die "iptables 放行失败"; FW_ADDED=1; persist_iptables; };; *) ok "未检测到需要处理的主机防火墙";; esac; }
configure_selinux(){ local p="$1" mode; command -v getenforce >/dev/null 2>&1 || return 0; mode="$(getenforce 2>/dev/null || true)"; [[ "$mode" == Enforcing || "$mode" == Permissive ]] || return 0; command -v semanage >/dev/null 2>&1 || die "SELinux 已启用但缺少 semanage。RHEL/Rocky/AlmaLinux 请安装 policycoreutils-python-utils。"; semanage port -l 2>/dev/null | awk '$1=="ssh_port_t"{for(i=3;i<=NF;i++)print $i}' | tr ',' '\n' | grep -qx "$p" && { ok "SELinux 已允许 TCP ${p}"; return; }; semanage port -a -t ssh_port_t -p tcp "$p" 2>/dev/null || semanage port -m -t ssh_port_t -p tcp "$p" 2>/dev/null || die "SELinux ssh_port_t 配置失败"; ok "SELinux 已允许 SSH 使用 TCP ${p}"; }
restart_ssh(){ if [[ "$SSH_SERVICE" != unknown ]] && command -v systemctl >/dev/null 2>&1; then systemctl restart "$SSH_SERVICE" || return 1; elif command -v service >/dev/null 2>&1; then service ssh restart 2>/dev/null || service sshd restart 2>/dev/null || return 1; else return 1; fi; [[ "$SSH_SOCKET" -eq 1 ]] && systemctl restart ssh.socket || true; }
backup_config(){ BACKUP_DIR="${BACKUP_ROOT}/$(date +%Y%m%d-%H%M%S)"; mkdir -p "$BACKUP_DIR"; cp -a "$SSHD_CONFIG" "$BACKUP_DIR/sshd_config"; [[ -d "$CONFIG_DIR" ]] && cp -a "$CONFIG_DIR" "$BACKUP_DIR/sshd_config.d"; [[ -d /etc/systemd/system/ssh.socket.d ]] && cp -a /etc/systemd/system/ssh.socket.d "$BACKUP_DIR/ssh.socket.d"; }
restore_backup(){ local b="$1"; [[ -d "$b" && -f "$b/sshd_config" ]] || die "备份目录无效：$b"; cp -a "$b/sshd_config" "$SSHD_CONFIG"; if [[ -d "$b/sshd_config.d" ]]; then rm -rf "$CONFIG_DIR"; cp -a "$b/sshd_config.d" "$CONFIG_DIR"; else rm -rf "$CONFIG_DIR"; mkdir -p "$CONFIG_DIR"; fi; rm -rf /etc/systemd/system/ssh.socket.d; [[ -d "$b/ssh.socket.d" ]] && cp -a "$b/ssh.socket.d" /etc/systemd/system/ssh.socket.d; command -v systemctl >/dev/null 2>&1 && systemctl daemon-reload 2>/dev/null || true; "$SSHD_BIN" -t || die "备份恢复后 sshd 配置校验失败，请保持当前会话并手动检查。"; restart_ssh || die "备份已恢复，但 SSH 服务重启失败，请保持当前会话并手动检查。"; }
auto_rollback(){ warn "开始自动恢复 SSH 配置……"; restore_backup "$BACKUP_DIR"; warn "SSH 配置已恢复。为避免失联，新端口的防火墙规则暂不删除。"; }
modify(){ local p="$1"; if grep -Eq '^[[:space:]]*Include[[:space:]].*sshd_config\.d' "$SSHD_CONFIG"; then mkdir -p "$CONFIG_DIR"; sed -i -E 's/^([[:space:]]*)Port[[:space:]]+([0-9]+)/\1# Port \2/' "$SSHD_CONFIG"; while IFS= read -r -d '' f; do [[ "$f" == "$CUSTOM_CONFIG" ]] && continue; sed -i -E 's/^([[:space:]]*)Port[[:space:]]+([0-9]+)/\1# Port \2/' "$f"; done < <(find "$CONFIG_DIR" -maxdepth 1 -type f -name '*.conf' -print0 2>/dev/null); printf '# Generated by SSH Port Changer V%s\nPort %s\n' "$VERSION" "$p" > "$CUSTOM_CONFIG"; else sed -i -E 's/^([[:space:]]*)Port[[:space:]]+([0-9]+)/\1# Port \2/' "$SSHD_CONFIG"; printf '\n# SSH Port Changer V%s\nPort %s\n' "$VERSION" "$p" >> "$SSHD_CONFIG"; fi; if [[ "$SSH_SOCKET" -eq 1 ]]; then mkdir -p /etc/systemd/system/ssh.socket.d; printf '[Socket]\nListenStream=\nListenStream=%s\n' "$p" > /etc/systemd/system/ssh.socket.d/listen.conf; systemctl daemon-reload; fi; }
save_state(){ mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"; printf 'OLD_PORT=%s\nNEW_PORT=%s\nFIREWALL=%s\nFIREWALL_RULE_ADDED=%s\nBACKUP_DIR=%s\nCHANGE_TIME=%s\n' "$1" "$2" "$3" "$4" "$5" "$(date --iso-8601=seconds 2>/dev/null || date)" > "$STATE_FILE"; chmod 600 "$STATE_FILE"; }
load_state(){ [[ -f "$STATE_FILE" ]] || die "没有找到历史修改记录"; OLD_PORT=""; NEW_PORT=""; SAVED_FIREWALL=""; FIREWALL_RULE_ADDED=""; BACKUP_DIR=""; CHANGE_TIME=""; while IFS='=' read -r k v; do case "$k" in OLD_PORT) OLD_PORT="$v";; NEW_PORT) NEW_PORT="$v";; FIREWALL) SAVED_FIREWALL="$v";; FIREWALL_RULE_ADDED) FIREWALL_RULE_ADDED="$v";; BACKUP_DIR) BACKUP_DIR="$v";; CHANGE_TIME) CHANGE_TIME="$v";; esac; done < "$STATE_FILE"; [[ "$OLD_PORT" =~ ^[0-9]+$ && "$NEW_PORT" =~ ^[0-9]+$ && "$BACKUP_DIR" == "$BACKUP_ROOT/"* ]] || die "状态文件内容异常，拒绝继续。"; }
status(){ local p conn; p="$(get_port)"; conn="${SSH_CONNECTION:-}"; echo; line; echo -e "${CYAN}SSH Port Changer V${VERSION}${NC}"; line; echo "系统：$OS_NAME"; echo "SSH 服务：$SSH_SERVICE"; echo "SSH Socket：$([[ $SSH_SOCKET -eq 1 ]] && echo Enabled || echo Disabled)"; echo "配置端口：$p"; echo "防火墙：$FIREWALL"; [[ -n "$conn" ]] && echo "当前 SSH 会话端口：$(awk '{print $4}' <<< "$conn")"; listening "$p" && ok "TCP $p 正在监听" || err "TCP $p 未监听"; if [[ -f "$STATE_FILE" ]]; then load_state; echo "上次修改：$OLD_PORT -> $NEW_PORT"; echo "修改时间：$CHANGE_TIME"; echo "备份目录：$BACKUP_DIR"; fi; echo; }
cleanup(){ load_state; listening "$NEW_PORT" || die "新端口 ${NEW_PORT} 未监听，拒绝清理旧端口"; [[ "$(get_port)" == "$NEW_PORT" ]] || die "当前 SSH 配置与记录不一致，拒绝清理"; local cp=""; [[ -n "${SSH_CONNECTION:-}" ]] && cp="$(awk '{print $4}' <<< "$SSH_CONNECTION")"; [[ "$cp" == "$OLD_PORT" ]] && warn "当前会话仍通过旧端口 ${OLD_PORT} 登录，强烈建议先用新端口建立另一个 SSH 会话。"; echo "将清理旧 SSH 防火墙端口：${OLD_PORT}/tcp"; read -r -p '确认？[y/N]: ' a; [[ "$a" =~ ^[Yy]$ ]] || exit 0; detect_fw; case "$FIREWALL" in UFW) ufw status | grep -Eq "^${OLD_PORT}/tcp[[:space:]]+ALLOW" && ufw --force delete allow "${OLD_PORT}/tcp" || true;; firewalld) local zones z; zones="$(firewall-cmd --get-active-zones 2>/dev/null | awk 'NF && $1 !~ /^[[:space:]]/{print $1}')"; [[ -z "$zones" ]] && zones="$(firewall-cmd --get-default-zone)"; while read -r z; do [[ -z "$z" ]] && continue; firewall-cmd --zone="$z" --query-port="${OLD_PORT}/tcp" >/dev/null 2>&1 && firewall-cmd --zone="$z" --remove-port="${OLD_PORT}/tcp" --permanent >/dev/null || true; done <<< "$zones"; firewall-cmd --reload >/dev/null || true;; iptables) iptables -C INPUT -p tcp --dport "$OLD_PORT" -j ACCEPT >/dev/null 2>&1 && { iptables -D INPUT -p tcp --dport "$OLD_PORT" -j ACCEPT; persist_iptables; } || true;; nftables) warn "独立 nftables 不自动删除规则，请手动检查旧端口。";; *) info "无需清理主机防火墙";; esac; ok "旧端口清理完成"; }
manual_rollback(){ load_state; echo "将恢复上次修改前的 SSH 配置：$BACKUP_DIR"; echo "记录：$OLD_PORT -> $NEW_PORT"; read -r -p '确认回滚？[y/N]: ' a; [[ "$a" =~ ^[Yy]$ ]] || exit 0; restore_backup "$BACKUP_DIR"; local restored; restored="$(get_port)"; ok "SSH 配置已回滚，当前配置端口：$restored"; warn "防火墙规则不会自动删除，请确认旧端口可正常登录后再手动清理不需要的规则。"; }
change(){ local new="$1" yes="$2" old; [[ "$new" =~ ^[0-9]+$ ]] || die "端口必须是数字"; ((new>=1 && new<=65535)) || die "端口范围必须为 1-65535"; old="$(get_port)"; [[ "$old" == "$new" ]] && { warn "当前已经是端口 $new"; exit 0; }; listening "$new" && die "目标端口 $new 已被占用"; echo; line; echo "SSH Port Changer V$VERSION"; echo "系统：$OS_NAME"; echo "当前端口：$old"; echo "目标端口：$new"; echo "防火墙：$FIREWALL"; line; if [[ "$yes" -eq 0 ]]; then read -r -p '是否继续？[Y/n]: ' a; case "${a:-Y}" in Y|y) ;; *) exit 0;; esac; fi; backup_config; ok "已备份到 $BACKUP_DIR"; allow_port "$new"; configure_selinux "$new"; modify "$new"; "$SSHD_BIN" -t || { err "sshd 配置检查失败"; auto_rollback; exit 1; }; [[ "$(get_port)" == "$new" ]] || { err "sshd 实际端口与目标不一致"; auto_rollback; exit 1; }; restart_ssh || { err "SSH 重启失败"; auto_rollback; exit 1; }; sleep 2; listening "$new" || { err "新端口未监听"; auto_rollback; exit 1; }; save_state "$old" "$new" "$FIREWALL" "$FW_ADDED" "$BACKUP_DIR"; echo; ok "SSH 已修改为端口 $new"; warn "不要关闭当前 SSH 窗口。请新开终端测试：ssh -p $new root@服务器IP"; warn "云服务器还需在云平台安全组/防火墙放行 TCP $new"; echo "确认新端口可登录后运行：$0 --cleanup"; echo "如需恢复上次配置：$0 --rollback"; }
help(){ cat <<EOF
SSH Port Changer V${VERSION}

用法：
  $0 PORT             修改 SSH 端口
  $0 PORT -y          无交互确认修改
  $0 --status         查看状态
  $0 --cleanup        清理旧端口防火墙规则
  $0 --rollback       恢复上次修改前的 SSH 配置
  $0 --help           显示帮助
EOF
}
ACTION="${1:-}"; case "$ACTION" in --status|-s) status; exit;; --cleanup|-c) cleanup; exit;; --rollback|-r) manual_rollback; exit;; --help|-h) help; exit;; '') read -r -p '请输入新的 SSH 端口: ' ACTION;; esac
YES=0; for a in "$@"; do [[ "$a" == -y || "$a" == --yes ]] && YES=1; done
change "$ACTION" "$YES"
